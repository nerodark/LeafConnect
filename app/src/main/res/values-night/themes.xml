<?xml version="1.0" encoding="utf-8"?>
<!-- Night, API 26: override of Theme.LeafConnectBase for dark mode. The
     surfaces come from values-night/colors.xml through the color NAMES; only
     the icon flags differ — on a dark surface the icons must be LIGHT. -->
<resources>
    <style name="Theme.LeafConnectBase" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
