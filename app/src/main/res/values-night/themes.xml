<?xml version="1.0" encoding="utf-8"?>
<!-- Night, API 26: override of Theme.LeafConnectBase for dark mode. The
     surfaces come from values-night/colors.xml through the color NAMES, so
     only the system-bar icon flags differ here: on a dark surface the icons
     must be LIGHT, hence windowLightStatusBar=false (the day files set true). -->
<resources>
    <style name="Theme.LeafConnectBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/green_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
