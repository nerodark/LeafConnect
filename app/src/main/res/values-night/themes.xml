<?xml version="1.0" encoding="utf-8"?>
<!-- Night, API 26: override of Theme.LeafConnectBase for dark mode. The
     surfaces and M3 roles come from values-night/colors.xml through the color
     NAMES (via Theme.LeafConnect.Colors), so only the system-bar icon flags
     differ here: on a dark surface the icons must be LIGHT, hence
     windowLightStatusBar=false (the day files set true). -->
<resources>
    <style name="Theme.LeafConnectBase" parent="Theme.LeafConnect.Colors">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
