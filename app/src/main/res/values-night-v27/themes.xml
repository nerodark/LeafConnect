<?xml version="1.0" encoding="utf-8"?>
<!-- Night, API 27+: nav-bar attrs need API 27, dark mode needs LIGHT icon
     flags. Wins over values-v27/ (day) and values-night/ (API 26). -->
<resources>
    <style name="Theme.LeafConnectBase" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
