<?xml version="1.0" encoding="utf-8"?>
<!-- Night, API 27+: the nav-bar attrs need API 27, and dark mode needs the
     LIGHT icon flags. This variant wins over values-v27/ (day) and
     values-night/ (API 26) on a night device at API 27+. The M3 roles still
     come from Theme.LeafConnect.Colors, resolved against values-night/. -->
<resources>
    <style name="Theme.LeafConnectBase" parent="Theme.LeafConnect.Colors">
        <item name="android:windowBackground">@color/window_bg</item>
        <!-- Dark surface → LIGHT status-bar icons. -->
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
