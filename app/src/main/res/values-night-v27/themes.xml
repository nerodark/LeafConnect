<?xml version="1.0" encoding="utf-8"?>
<!-- Night, API 27+: the nav-bar attrs need API 27, and dark mode needs the
     LIGHT icon flags. This variant wins over values-v27/ (day) and
     values-night/ (API 26) on a night device at API 27+. -->
<resources>
    <style name="Theme.LeafConnectBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/green_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <!-- Dark surface → LIGHT status-bar icons. -->
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
