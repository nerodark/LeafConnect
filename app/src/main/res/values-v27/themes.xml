<?xml version="1.0" encoding="utf-8"?>
<!-- Day, API 27+: android:windowLightNavigationBar does not exist below API 27
     (NewApi: minSdk 26 < 27), so the nav-bar attrs live only here. A
     config-specific override REPLACES the style, so the base items are
     re-declared. Theme.LeafConnect is NOT declared here: values/ (and
     values-v31/) provide it and inherit this Base variant. -->
<resources>
    <style name="Theme.LeafConnectBase" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Navigation bar: same surface, dark icons on the light surface. -->
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
