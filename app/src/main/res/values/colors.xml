<?xml version="1.0" encoding="utf-8"?>
<!-- Android-side colors for the window chrome only: the splash/background
     (@color/window_bg, mode-aware via values-night/) and the launcher plate.
     The UI palette lives in shared Theme.kt, so no brand colors are declared
     here. -->
<resources>
    <!-- Launcher icon plate (adaptive-icon background). Deliberately NOT
         overridden in values-night/: the drawer icon keeps its white plate. -->
    <color name="icon_plate">#FFFFFF</color>

    <!-- Every window/screen background goes through window_bg so
         values-night/ flips it with the system dark mode. -->
    <color name="window_bg">#FFFFFF</color>
</resources>
