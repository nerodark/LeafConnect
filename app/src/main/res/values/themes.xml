<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared base items for every API level. Theme.LeafConnect itself is
         overridden in values-v31/ with the API 31+ splash attributes, which
         must not appear in the base (NewApi: minSdk 26 < 31). -->
    <style name="Theme.LeafConnectBase" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/green_dark</item>
        <item name="colorAccent">@color/accent</item>
        <!-- Launch screen: on API 26-30 the window background is the launch
             screen. -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.LeafConnect" parent="Theme.LeafConnectBase" />
</resources>
