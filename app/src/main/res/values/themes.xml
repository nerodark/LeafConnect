<?xml version="1.0" encoding="utf-8"?>
<!-- Day, API 26. The app is Compose (ComponentActivity), so the window chrome
     uses platform Material themes rather than AppCompat. Resolution rules:
       values/           day, API 26
       values-v27/       day, API 27+   (nav-bar attrs; minSdk 26 < 27)
       values-night/     night, API 26
       values-night-v27/ night, API 27+
     Theme.LeafConnect is declared ONLY here and in values-v31/, so a night
     device never loses the splash attrs: it inherits the night Base variant. -->
<resources>
    <style name="Theme.LeafConnectBase" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <!-- Status bar: same surface as the screen under it. Apps targeting
             SDK 35 are edge-to-edge, so the flag below (dark icons on the
             light surface) is what keeps the clock/battery legible. -->
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.LeafConnect" parent="Theme.LeafConnectBase" />
</resources>
