<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- fillViewport + weight=1 on the vehicle container: the LOGOUT
             button scrolls with the vehicles but is pushed to the bottom of
             the screen whenever the content is shorter than the screen. -->
        <!-- fitsSystemWindows: on devices whose window draws under the nav
             bar (tablets with 3-button nav), inset the scroll content so the
             bottom-pinned LOGOUT button is never covered by the system bar. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:fitsSystemWindows="true">

            <!-- The 24dp content padding lives on the INNER layout, not the
                 ScrollView: fitsSystemWindows on the ScrollView REPLACES its
                 XML padding with the system-bar insets — on a tablet the
                 insets are ~0, so the 24dp vanished and text hit the screen
                 edge. Inner padding is always applied, on top of the insets. -->
            <!-- 0dp inside a fillViewport ScrollView: the high-performance
                 form (no wrap_content measure pass). No layout_weight — a
                 ScrollView is not a LinearLayout, weight has no effect. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Last requested command + its outcome (success / failed).
                     On top of the vehicle list, bold and prominent. -->
                <TextView
                    android:id="@+id/cmd_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- 0dp + weight 1: the high-performance form for a weighted
                     child (wrap_content would force an extra measure pass). -->
                <LinearLayout
                    android:id="@+id/container_home"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical" />

                <!-- Inside the scrollview with the vehicles, pinned to the
                     bottom of the screen when the content is short. Same
                     fixed width as the LOGIN button. -->
                <Button
                    android:id="@+id/btn_log_out"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/log_out" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Full-screen loading overlay — CANCEL (not the overlay itself)
         cancels the in-progress fetch -->
    <!-- The overlay is a single LinearLayout (the FrameLayout wrapper with a
         single child was unnecessary); the dark background lives here. -->
    <LinearLayout
        android:id="@+id/overlay_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pb_home"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@android:string/cancel" />
    </LinearLayout>

    <!-- Splash hold: white screen with the app icon, shown for 1s on launch
         (the system splash is dismissed at the first frame). -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />
    </FrameLayout>
</FrameLayout>
