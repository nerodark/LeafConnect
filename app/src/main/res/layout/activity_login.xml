<?xml version="1.0" encoding="utf-8"?>
<!-- No root background: the theme already paints android:windowBackground
     (@color/window_bg, day or night), so a root background would only add
     overdraw. -->
<!-- The root FrameLayout is the Snackbar anchor for login failures and
     connection errors (Snackbar attaches itself to the activity content view). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ScrollView so the form stays reachable in landscape (short height);
         fillViewport keeps it centered when everything fits. -->
    <!-- fitsSystemWindows: keeps the form clear of the system bars on
         devices whose window draws under them (e.g. tablet nav bar). -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />

        <!-- M3 outlined text fields: the label floats into the outline, so the
            hint is not the only label and the inline error sits under the box. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_username"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_user">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="email"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Account region: the backend ties an account to Canada (CA) or the
             United States (US) and rejects a mismatch with its generic
             "Password or Username is incorrect" error, so the region is chosen
             here. It starts from the device locale and is stored, so every
             later auth call (soft login, re-authentication) uses the region the
             session was created with. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/region_label"
            android:textAppearance="@style/TextAppearance.LeafConnect.FieldLabel" />

        <!-- M3 segmented buttons instead of radio buttons: two mutually
             exclusive, always-one-selected choices. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/rg_region"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rb_region_canada"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/region_canada" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rb_region_us"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/region_us" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            style="@style/Widget.LeafConnect.Button"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login" />

        <!-- Keep credentials: persist email/password for next launch.
             Auto-login: on launch, log in straight to the home screen with
             the saved credentials. Each row = box + text, vertically centered
             so the text always lines up with its box. Tapping the row toggles. -->
        <LinearLayout
            android:id="@+id/row_keep_credentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_keep_credentials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/keep_credentials"
                android:textAppearance="@style/TextAppearance.LeafConnect.CheckRow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_auto_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_auto_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/auto_login"
                android:textAppearance="@style/TextAppearance.LeafConnect.CheckRow" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <!-- Splash hold: screen in the theme surface color with the app icon,
         shown for 1s on launch (the system splash is dismissed at the first
         frame). window_bg follows dark mode, so the hold never flashes white. -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_bg">

        <ImageView
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />
    </FrameLayout>

    <!-- Full-screen loading overlay -->
    <!-- fitsSystemWindows: the dim stops at the system bars instead of
         darkening them, so the status bar stays white with dark icons
         (Theme.LeafConnect sets windowLightStatusBar). -->
    <FrameLayout
        android:id="@+id/overlay_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pb_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/scrim_indicator" />
    </FrameLayout>
</FrameLayout>
